# Copy this file to .env and fill in your existing database/account details.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_existing_mysql_user
DB_PASSWORD='your_password_here'
DB_NAME=your_existing_database_name
# Required for remote MySQL: trusted CA certificate path; hostname must match certificate.
# DB_SSL_CA=C:/path/to/ca.pem
